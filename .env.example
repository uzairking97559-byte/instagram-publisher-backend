# Set values privately. Never commit .env or paste secrets into chat.
NODE_ENV=development
PORT=3000
REDIRECT_URI=http://localhost:3000/auth/meta/callback
META_GRAPH_VERSION=v24.0

# Private, single-owner dashboard; use a generated unique password (16-256 chars).
DASHBOARD_PASSWORD=
# Base64 encoding of exactly 32 random bytes; keep stable and back up privately.
TOKEN_ENCRYPTION_KEY=
DATABASE_URL=
# verify-full checks the server certificate; require keeps TLS on for Render's
# self-signed internal Postgres certificate; disable is only for local testing.
PGSSL=verify-full

# Videos kept in Postgres at once, in MB (default 500). Keep it well below the
# database disk size; Render suspends a database that runs out of storage.
MEDIA_STORAGE_LIMIT_MB=

# Facebook Login credentials
META_APP_ID=
META_APP_SECRET=
# Separate credentials from Instagram API setup with Instagram Login
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# DM Sender (DMs tab): Browser Use Cloud API key. Without it campaigns can be
# saved but not started.
BROWSER_USE_API_KEY=
# Proxy a new DM campaign starts with: a country code (default in) or none.
DM_PROXY_COUNTRY=
# Rupees per US dollar for the cost shown on DM campaigns (default 96.5).
DM_USD_INR=

# Reel frames use the ffmpeg that `npm install` downloads into bin/. Set a path
# to use another one, or SKIP_FFMPEG_DOWNLOAD=1 to skip the download.
FFMPEG_PATH=
