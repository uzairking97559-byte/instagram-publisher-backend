# Meta app credentials (store real values only in Render's secret environment settings)
META_APP_ID=
META_APP_SECRET=
REDIRECT_URI=https://instagram-publisher-backend-5rud.onrender.com/auth/meta/callback
META_GRAPH_VERSION=v24.0

# Persistent token and OAuth state storage
DATABASE_URL=
# Base64 encoding of exactly 32 random bytes. Generate locally; never commit the real value.
TOKEN_ENCRYPTION_KEY=
# Optional: set to "disable" only for a local database without TLS.
PGSSL=
