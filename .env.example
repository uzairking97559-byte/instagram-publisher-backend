# Set values privately. Never commit .env or paste secrets into chat.
NODE_ENV=development
PORT=3000
REDIRECT_URI=http://localhost:3000/auth/meta/callback
META_GRAPH_VERSION=v24.0

# Private, single-owner dashboard; use a generated unique password (16-256 chars).
DASHBOARD_PASSWORD=
# Base64 encoding of exactly 32 random bytes; keep stable and back up privately.
TOKEN_ENCRYPTION_KEY=
DATABASE_URL=
# verify-full checks the server certificate; require keeps TLS on for Render's
# self-signed internal Postgres certificate; disable is only for local testing.
PGSSL=verify-full

# Facebook Login credentials
META_APP_ID=
META_APP_SECRET=
# Separate credentials from Instagram API setup with Instagram Login
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
